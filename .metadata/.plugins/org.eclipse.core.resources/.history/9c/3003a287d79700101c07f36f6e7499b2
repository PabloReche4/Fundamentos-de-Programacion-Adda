public static String carrera2NoFinal(Integer min, Integer dias) {
	String ac=null;
	if (dias<=1) {
		ac="ultimo entreno hace "+ dias +"dias";
	}else if(min>=120){
		ac="resto de entrenos: 120";
	}else {
		ac=dias +"dias "+ min+ "minutos"+ carrera2NoFinal((int) (min+min*0.2), dias-1);
	}
	return ac;
}
public static String carrera2Final(Integer min, Integer dias) {
	return carrera2Final("",min, dias);
}
private static String carrera2Final(String ac, Integer min, Integer dias) {
	if (dias<=1) {
		ac="ultimo entreno hace "+ dias +"dias";
	}else if(min>=120){
		ac="resto de entrenos: 120";
	}else {
		ac=dias +"dias "+ min+ "minutos"+ carrera2Final((int) (min+min*0.2), dias-1);
	}
	return ac;
}

