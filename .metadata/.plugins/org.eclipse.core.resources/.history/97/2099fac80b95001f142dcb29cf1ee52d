package exercises;

import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;
import java.util.Set;




public class Exercise3 {
	public static Set<Integer> ejercicio3RecursivoSinMemoria(Integer a, Integer b, Integer c) {
		Set<Integer>res=new HashSet<>();
		if(a<=5||b<=3||c<=2) {
			res.add(2*a);
			res.add(b+3);
			res.add(c);
		}else {
			res.addAll(ejercicio3RecursivoSinMemoria(a-5, b/4, c-2));
			res.addAll(ejercicio3RecursivoSinMemoria(a/3, b-3, c/2));
		}
		return res; 
	}
	
	public static Set<Integer> ejercicio3RecursivoConMemoria(Integer a, Integer b, Integer c) {
		return ejercicioConMemoria( a,  b,  c, new HashMap<>());
	}
	
	private static Set<Integer> ejercicioConMemoria(Integer a, Integer b, Integer c, Map<Tupla, Set<Integer>> m) {
		Set<Integer>res=new HashSet<>();
		Tupla key=Tupla.of(a, b, c);
		if(m.containsKey(key)) {
			res.addAll(m.get(key));
		} else {
			if (a <=5 || b <=3 || c<=2) {
				res.add(2*a);
				res.add(b+3);
				res.add(c);
				m.put(key, res);
			} else {
				res.addAll(ejercicioConMemoria(a-5, b-3, c/2, m));
				res.addAll(ejercicioConMemoria(a/3, b-3, c/2, m));
				m.put(key, res);
			}
			m.put(key, res);
		}
		return res;
	}

	public static Set<Integer> ejercicio3Iterativo(Integer a, Integer b, Integer c) {
		Map<Tupla, Set<Integer>>res=new HashMap<>();
		Set<Integer>s=new HashSet<>();
		for(int i=0;i<=a;i++) {
			for(int j=0;j<=b;j++) {
				for(int k=0;k<=c;k++) {
					if(i<=5|| j<=3 || k<=2) {
						s.add(2*a);
						s.add(b+3);
						s.add(c);
					}else {
						s.addAll(res.get(Tupla.of(a-5, b, c/2)));
						s.addAll(res.get(Tupla.of(a/3,b-3,c/2)));
						
					}
				}
			}
			res.put(Tupla.of(a, b, c), s);
		}
		
		return s;
	}
	
	public static record Tupla(Integer a, Integer b, Integer c) {
		public static Tupla of(Integer a, Integer b, Integer c) {
			return new Tupla(a, b, c);
		}
	}

}
