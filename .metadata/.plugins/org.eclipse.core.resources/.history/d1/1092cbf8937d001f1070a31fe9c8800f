	public static Grupo  leeEstudiantes(String ruta) {
		Grupo res=null;
		try {
			Stream <Estudiante> sv=Files.lines(Paths.get(ruta))
					.skip(1)
					.map(FactoriaGrupo::parsearEstudiante);
			res= new Grupo(sv);
			}catch(IOException e) {
				System.out.println("No se ha encontrado el fichero"+ruta);
				e.printStackTrace();
			}
		return res;
	}
	private static Estudiante parsearEstudiante(String s) {
		String[]trozos=s.split(";");
		Checkers.check("Formato no válido", s.length()==5);
		String nombre=trozos[0].trim();
		LocalDate fechaNacimiento=LocalDate.parse(trozos[0].trim(),
				DateTimeFormatter.ofPattern("dd/MM/yyyy"));
		Boolean esRepetidor=parsearBoolean(trozos[2].trim());
		Double notaMedia=Double.valueOf(trozos[3].trim());
		Set<Asignatura>asiganturas=parsearAsignaturas(trozos[4].trim());
		return new Estudiante(nombre, fechaNacimiento, esRepetidor, notaMedia, asiganturas);
		
	}
	private static Set<Asignatura> parsearAsignaturas(String a) {
		Set<Asignatura>set=new HashSet<Asignatura>();
		String limpia=a.replace("[", "").replace("]", "").trim();
		if(!limpia.equals("")) {
			String[]trozos=limpia.split(",");
			for(String trozo:trozos) {
				String [] t=trozo.split("-");
				String id=t[0].trim();
				Integer creditos=Integer.parseInt(t[1].trim());
				
			}
		}
		return null;
	}
	private static Boolean parsearBoolean(String a) {
			return a.trim().equals("si")?true:false;
	}

	
